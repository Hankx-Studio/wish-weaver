[gd_scene load_steps=21 format=3]

; Red torii gate + stone lantern path. Feet origin, gate faces +Z.
; Leader places the ToriiGate root at (18, 0, -30) with yaw 0.
;
; LanternPath children are stored torii-relative (world minus (18, -30)) so
; they land on the three.js props.ts spots (4,-2) (7,-13) (13,-21) plus three
; mirrored partners flanking the spawn-to-arch path:
;   L0 (-14, 28)    -> world (4, -2)      L3 (-11.7, 29.2) -> world (6.3, -0.8)
;   L1 (-11, 17)    -> world (7, -13)     L4 (-8.7, 18.2)  -> world (9.3, -11.8)
;   L2 (-5, 9)      -> world (13, -21)    L5 (-2.7, 10.2)  -> world (15.3, -19.8)

