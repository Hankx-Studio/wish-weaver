# Copy to .env (never commit .env). The key stays on the server only.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Player-facing traffic uses standard tier (player text is not used for training).
MODEL_TEXT=muse-spark-1.3
MODEL_IMAGE=muse-image-1.0
MODEL_SEG=sam-3.1
MODEL_ASR=muse-voice-transcribe-1.0

PORT=8787

# Budget guard (USD). When exceeded, endpoints return source="fallback_fixture".
DAILY_BUDGET_USD=5
TOTAL_BUDGET_USD=100

# Per-IP limits
LIMIT_WISH_PER_HOUR=30
LIMIT_EVOLVE_PER_DAY=6
LIMIT_SCAN_PER_DAY=10
LIMIT_TRANSCRIBE_PER_HOUR=30
